{
  "name": "writ-mcp",
  "version": "1.2.1",
  "mcpName": "app.usewrit/writ-cloud",
  "description": "Official Writ MCP bridge: connect Claude Code, Claude Desktop, Cursor, Windsurf or Codex to Writ Cloud with an API key, and call your website APIs as MCP tools. Zero dependencies.",
  "license": "MIT",
  "author": "The Writ Project Authors",
  "homepage": "https://usewrit.app/docs/mcp/",
  "bugs": {
    "url": "https://github.com/usewrit/writ-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usewrit/writ-mcp.git"
  },
  "type": "commonjs",
  "bin": {
    "writ-mcp": "index.js"
  },
  "files": [
    "index.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "writ",
    "website-to-api",
    "web-scraping",
    "browser-automation",
    "claude",
    "cursor",
    "ai-agents"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "node --test test/*.test.js"
  }
}
